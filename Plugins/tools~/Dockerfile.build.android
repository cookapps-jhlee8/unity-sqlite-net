# syntax=docker/dockerfile:1
FROM debian:12-slim

ARG NDK_VERSION=r26c

# 1. 필수 도구 설치
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    unzip \
    make \
    build-essential \
    git \
    perl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 2. Android NDK 설치
RUN curl -SLO https://dl.google.com/android/repository/android-ndk-${NDK_VERSION}-linux.zip \
    && unzip android-ndk-${NDK_VERSION}-linux.zip \
    && mv android-ndk-${NDK_VERSION} /opt/ndk \
    && rm android-ndk-${NDK_VERSION}-linux.zip

ENV ANDROID_NDK_ROOT=/opt/ndk
ENV PATH=$ANDROID_NDK_ROOT/toolchains/llvm/prebuilt/linux-x86_64/bin:$PATH

# 3. OpenSSL 소스 다운로드
WORKDIR /src
RUN git clone --depth=1 --branch openssl-3.0.12 https://github.com/openssl/openssl.git

# 4. OpenSSL 빌드 (arm64-v8a, armeabi-v7a 전용)
RUN for ABI in \
    "arm64-v8a android-arm64 aarch64-linux-android" \
    "armeabi-v7a android-arm armv7a-linux-androideabi"; do \
    set -- $ABI; \
    ABI_NAME=$1; CONFIGURE_NAME=$2; HOST=$3; \
    TOOLCHAIN=/opt/ndk/toolchains/llvm/prebuilt/linux-x86_64/bin; \
    export PATH=$TOOLCHAIN:$PATH; \
    CC_BIN=$TOOLCHAIN/${HOST}21-clang; \
    AR_BIN=$TOOLCHAIN/llvm-ar; \
    echo "CC: $CC_BIN"; echo "AR: $AR_BIN"; \
    [ -f "$CC_BIN" ] || (echo "❌ CC not found: $CC_BIN" && exit 1); \
    [ -f "$AR_BIN" ] || (echo "❌ AR not found: $AR_BIN" && exit 1); \
    cd /src/openssl && make clean || true; \
    ./Configure $CONFIGURE_NAME no-shared no-tests --prefix=/src/openssl/build/$ABI_NAME && \
    make CC=$CC_BIN AR=$AR_BIN -j$(nproc) && \
    make install_sw; \
  done

# 5. OpenSSL 빌드 결과 복사 및 확인
RUN mkdir -p /output/openssl
RUN cp -r /src/openssl/build/* /output/openssl/

# 6. 빌드 결과 디버깅
RUN ls -la /src/openssl/build/
RUN find /src/openssl/build/ -name "crypto.h" | xargs ls -la
RUN find /output/openssl/ -name "crypto.h" | xargs ls -la

# 7. 로컬 헤더 심볼릭 링크 생성
RUN mkdir -p /usr/include/openssl
RUN for ABI in arm64-v8a armeabi-v7a; do \
    if [ -d "/src/openssl/build/$ABI/include/openssl" ]; then \
      echo "Linking OpenSSL headers from $ABI"; \
      ln -sf /src/openssl/build/$ABI/include/openssl/* /usr/include/openssl/; \
      break; \
    fi; \
  done

# 8. 작업 디렉토리 설정
WORKDIR /output

