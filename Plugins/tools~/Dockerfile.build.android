# syntax=docker/dockerfile:1
FROM debian:12-slim

ARG NDK_VERSION=r26c

# 필수 도구 설치
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    unzip \
    make \
    build-essential \
    git \
    perl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Android NDK 설치
RUN curl -SLO http://dl.google.com/android/repository/android-ndk-${NDK_VERSION}-linux.zip \
    && unzip android-ndk-${NDK_VERSION}-linux.zip \
    && mv android-ndk-${NDK_VERSION} /opt/ndk \
    && rm android-ndk-${NDK_VERSION}-linux.zip

ENV ANDROID_NDK_ROOT=/opt/ndk
ENV PATH=$ANDROID_NDK_ROOT/toolchains/llvm/prebuilt/linux-x86_64/bin:$PATH

# OpenSSL 소스 클론
WORKDIR /src
RUN git clone --depth=1 --branch openssl-3.4.1 https://github.com/openssl/openssl.git

# ✅ arm 계열 (arm64-v8a, armeabi-v7a)만 빌드
RUN for ABI in \
    "arm64-v8a android-arm64 aarch64-linux-android" \
    "armeabi-v7a android-arm armv7a-linux-androideabi"; do \
    set -- $ABI; \
    ABI_NAME=$1 CONFIGURE=$2 HOST=$3; \
    cd /src/openssl && make clean || true; \
    CC=$HOST21-clang \
    AR=$HOST-ar \
    ./Configure $CONFIGURE no-shared no-tests --prefix=/src/openssl/build/$ABI_NAME && \
    make -j$(nproc) && \
    make install_sw; \
  done
